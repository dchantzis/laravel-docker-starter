# Docker Compose environment (NOT the Laravel application/.env)
COMPOSE_PROJECT_NAME=laravel-docker-starter
APP_IMAGE=laravel-docker-starter:local
APP_PORT=8091
DB_PORT=33090
REDIS_PORT=6390
DB_DATABASE=laravel_starter
DB_USER=laravel
DB_PASSWORD=laravel-local-password
DB_ROOT_PASSWORD=root-local-password
XDEBUG_MODE=off
